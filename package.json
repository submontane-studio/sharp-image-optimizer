{
  "name": "@submontane-studio/sharp-image-optimizer",
  "version": "1.0.3",
  "description": "プロ仕様の画像一括変換ツール（sharp ベース）",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/submontane-studio/sharp-image-optimizer.git"
  },
  "bin": {
    "sharp-image-optimizer": "./dist/bin/cli.js",
    "sio": "./dist/bin/cli.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/cli.js",
    "dev": "tsc --watch",
    "test": "node dist/bin/cli.js -i ./test-images -o ./test-output -w -m --cache",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "image",
    "optimizer",
    "sharp",
    "webp",
    "avif",
    "svg",
    "compression"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "fs-extra": "^11.0.0",
    "glob": "^11.0.0",
    "p-limit": "^6.0.0",
    "sharp": "^0.34.0",
    "svgo": "^4.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
